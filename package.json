{
  "name": "kinga",
  "version": "0.1.0",
  "description": "Kinga: an offline security framework that scans live websites and code under development, then explains the best fix.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kinga": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "security",
    "scanner",
    "appsec",
    "sast",
    "vulnerability",
    "devsecops",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import('node:fs').then((f) => f.chmodSync('dist/cli.js', 0o755))\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "kinga": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  }
}
